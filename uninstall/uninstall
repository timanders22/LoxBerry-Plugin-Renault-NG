#!/bin/bash
# Renault - uninstall
# command <TEMPFOLDER> <NAME> <FOLDER> <VERSION> <BASEFOLDER>
#
# Wird von LoxBerry als root ausgefuehrt. Rueckgabewert 0 = in Ordnung,
# 1 = Warnung (die Deinstallation laeuft trotzdem weiter).
#
# ===================================================================
# ZUR VORGESCHICHTE DIESER DATEI - bitte nicht wieder aufheben
# ===================================================================
#
# Bis 1.5 stand hier die unveraenderte LoxBerry-Beispieldatei: zwoelf
# Variablenzuweisungen (PCGI, PHTML, PTEMPL, PDATA, PLOG, PCONFIG,
# PSBIN, PBIN ...), elf echo-Zeilen, die diese Pfade ins
# Installationsprotokoll schrieben, und "exit 0". Sie hat nichts
# aufgeraeumt - sie hat nur ausgesehen, als taete sie es.
#
# Nachgesehen, was das Plugin ausserhalb seiner eigenen Ordner
# hinterlaesst:
#
#   Dateien:  nichts. Die dauerhafte Konfigurationssicherung liegt in
#             config/plugins/<ordner>/config.php.backup, also INNERHALB
#             des Plugin-Konfigordners - LoxBerry raeumt ihn mit weg.
#             Ebenso data/, log/ und die beiden webfrontend-Ordner.
#             Die Zugangsdaten (webfrontend/htmlauth/config.php) gehen
#             damit ebenfalls.
#   Prozesse: keine. Das Plugin arbeitet ueber cron (cron.03min,
#             cron.10min); LoxBerry entfernt die Eintraege selbst.
#             Einen Dienst gibt es nicht.
#   MQTT:     hier bleibt etwas stehen - siehe unten.
#
# Deshalb tut diese Datei genau eine Sache: sie sagt, was der Broker
# noch enthaelt. Etwas vorzutaeuschen, das sie nicht kann, waere
# schlechter als die alte Beispieldatei.

PDIR=$3
[ -n "$PDIR" ] || PDIR="renault_ng"

echo "<INFO> Plugin-Ordner, Konfiguration und Zugangsdaten entfernt LoxBerry selbst."
echo "<INFO> Das Plugin hat weder einen Dienst noch Dateien ausserhalb seiner Ordner."
echo ""
echo "<WARNING> Im MQTT-Broker bleiben Werte stehen."
echo "<INFO> Das Plugin sendet seine Werte mit gesetztem Retain-Merker"
echo "<INFO> (abruf.php: \$mqtt->publish(..., 0, 1) - die letzte 1 ist Retain)."
echo "<INFO> Ein solcher Wert bleibt im Broker gespeichert, bis ihn jemand"
echo "<INFO> ueberschreibt oder loescht; das Entfernen des Plugins beruehrt ihn"
echo "<INFO> nicht. Betroffen sind alle Topics unter"
echo "<INFO>     Renault/<Fahrzeugname>/..."
echo "<INFO> (BattSOC, ChargingStatus, CableStatus, Range, ChargingTime,"
echo "<INFO> ChargingEffekt, ChargeMode, GPSTime, LastDataRetrieval u. a.)."
echo "<INFO>"
echo "<INFO> Zum Aufraeumen: LoxBerry -> System -> MQTT Gateway, dort in der"
echo "<INFO> Uebersicht der eingehenden Topics die Renault-Eintraege loeschen."
echo "<INFO> Wer das nicht tut, sieht dort noch jahrelang den Ladestand vom"
echo "<INFO> Tag der Deinstallation - und Loxone liest ihn beim naechsten"
echo "<INFO> Verbinden erneut ein."

exit 0
