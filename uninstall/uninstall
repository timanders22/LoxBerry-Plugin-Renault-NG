#!/bin/bash
# Renault - uninstall
# command <TEMPFOLDER> <NAME> <FOLDER> <VERSION> <BASEFOLDER>
#
# Wird von LoxBerry als root ausgefuehrt. Rueckgabewert 0 = in Ordnung,
# 1 = Warnung (die Deinstallation laeuft trotzdem weiter).
#
# ===================================================================
# ZUR VORGESCHICHTE DIESER DATEI - bitte nicht wieder aufheben
# ===================================================================
#
# Bis 1.5 stand hier die unveraenderte LoxBerry-Beispieldatei: zwoelf
# Variablenzuweisungen, elf echo-Zeilen mit Pfaden und "exit 0". Sie hat
# nichts aufgeraeumt - sie hat nur ausgesehen, als taete sie es.
#
# Bis 2.1.5 stand hier dann etwas Falsches: der Text behauptete, die
# dauerhafte Konfigurationssicherung liege IM Konfigordner und werde mit
# ihm zusammen entfernt. (Der alte Wortlaut steht hier absichtlich nicht -
# sonst faende ihn jede Suche, die pruefen soll, ob er fort ist.)
# Er beschrieb den Stand bis 2.0.6. Seit 2.1.0 liegt die Zweitschrift
# NEBEN dem Ordner (config/plugins/<ordner>.backup.config.php) - genau
# deshalb ueberlebt sie das Loeschen, und genau deshalb blieb nach dem
# Entfernen des Plugins das My-Renault-Kennwort im Klartext auf der Anlage
# stehen. Eine spaetere Neuinstallation holte es ueber rn_umzug() samt
# Aktionstoken von selbst zurueck: was als Selbstheilung gedacht ist, war
# beim Entfernen das Gegenteil.
#
# Seit 2.1.6 raeumt diese Datei deshalb selbst auf. Seit 2.1.11 leert sie
# auch die zurueckbehaltenen MQTT-Themen der eingerichteten Fahrzeuge und
# liest beim Broker nach (abruf.php --mqtt-leeren); bis 2.1.10 sagte sie
# nur, dass der Broker bleibt.

# V5 (Gruppe 40): die $2-Wache als erste wirksame Zeile (Gedaechtnis
# "Uninstall-Praefix"). LoxBerry ruft beim Entfernen eines Plugins die uninstall
# ANDERER Plugins mit, deren Name mit diesem beginnt (zigbee2mqtt riss
# zigbee2mqttng mit). Ein Aufruf fuer einen anderen Namen tut hier nichts.
# 2.1.23 (Fremdpruefung B1, Form wie die uebrigen Linien, etwa Bewaesserung): ein LEERES $2 gehoert keinem fremden
# Plugin - plugininstall.pl ruft nur mit gesetztem $pname (am Geraet gelesen, :1568 und :1577). Das ist der
# Handaufruf; er endete bis 2.1.22 mit "anderes Plugin ()" und raeumte nichts ab. Ohne Wurzel bleibt er unten stehen.
if [ -n "$2" ] && [ "$2" != "renault_ng" ]; then
    echo "<INFO> Aufruf fuer ein anderes Plugin ($2) - nichts zu tun."
    exit 0
fi

PDIR="$3"
[ -n "$PDIR" ] || PDIR="renault_ng"
# Der Ordnername darf keinen Pfadtrenner tragen (wie preinstall.sh) - sonst
# griffen rm und dd daneben.
case "$PDIR" in
    ''|.|..|*/*|*..*) echo "<FAIL> Ungueltiger Ordnername"; exit 2 ;;
esac
BASE="$5"
if [ -z "$BASE" ] || [ ! -d "$BASE" ]; then
    BASE="$LBHOMEDIR"
fi
# Fail closed: ohne Wurzel wird nichts geloescht, sondern gesagt, was
# liegenbleibt. Ein rm mit leerem Praefix ist schlimmer als ein Rest.
#
# Eine Wurzel ist nur, was config/plugins UND config/system/general.json
# traegt - ein LoxBerry hat sie immer, ein Rest eines Pruefstands nie
# (Regeln/06, "Eine Wurzelsuche ... trifft auf einem Pruefrechner das
# Laufwerk selbst"). Bis 2.1.10 genuegte config/plugins, und in einem
# fremden Baum wurde dessen Zweitschrift geloescht (in WSL gemessen,
# Pruefung-Renault-NG-2.1.11, Fall U4).
if [ -z "$BASE" ] || [ ! -d "$BASE/config/plugins" ] \
   || [ ! -f "$BASE/config/system/general.json" ]; then
    echo "<WARNING> Der LoxBerry-Ordner liess sich nicht bestimmen."
    echo "<WARNING> Die Zweitschrift der Konfiguration wurde NICHT entfernt."
    echo "<INFO> Sie enthaelt Benutzername und Kennwort des My-Renault-Kontos"
    echo "<INFO> im Klartext und liegt unter"
    echo "<INFO>     <loxberry>/config/plugins/$PDIR.backup.config.php"
    echo "<INFO> Bitte von Hand loeschen."
    exit 1
fi

rc=0

# ---- 0a. Befehlsbruecke anhalten (seit 2.1.20, Hausform 2.2) ---------
# VOR dem Leeren, solange bin/ noch da ist: stop beendet Dienst und
# mosquitto_sub. Den Pfad setzt der Installer ein.
BBSH="REPLACELBPBINDIR/befehlsbruecke.sh"
case "$BBSH" in
    /?*) [ -f "$BBSH" ] || BBSH="" ;;
    *) BBSH="$BASE/bin/plugins/$PDIR/befehlsbruecke.sh"; [ -f "$BBSH" ] || BBSH="" ;;
esac
if [ -n "$BBSH" ]; then
    timeout -k 5 40 bash "$BBSH" stop 2>&1 | head -n 3 | sed 's/^/<INFO> Befehlsbruecke: /'
else
    echo "<INFO> Befehlsbruecke: befehlsbruecke.sh fehlt - nichts anzuhalten."
fi
# Die Optionsdateien (Broker-Benutzer und -Kennwort) der Bruecke und des Lesers
# werden ueberschrieben, bevor LoxBerry data/plugins/<ordner>/ abraeumt - eine
# geloeschte Datei mit Kennwort ist auf einer SD-Karte noch eine Weile lesbar.
for RN_F in "$BASE/data/plugins/$PDIR/befehle/mosquitto/mosquitto_sub" "$BASE/data/plugins/$PDIR/befehle/mosquitto/mosquitto_pub"             "$BASE/data/plugins/$PDIR/mosquitto/mosquitto_sub" "$BASE/data/plugins/$PDIR/mosquitto/mosquitto_pub"; do
    [ -f "$RN_F" ] && [ ! -L "$RN_F" ] || continue
    head -c "$(stat -c %s "$RN_F" 2>/dev/null || echo 64)" /dev/zero > "$RN_F" 2>/dev/null
done

# ---- 0. Zurueckbehaltene MQTT-Themen -----------------------------
# VOR dem Loeschen der Zweitschrift: aus Konfiguration bzw. Zweitschrift
# kommen die Fahrzeugnamen, und sie sind Teil der Themen. Der Weg ist der der
# Linie (direkt am Broker, mit den Zugangsdaten des Gateways); geloescht wird
# nur, was der Broker noch zurueckbehaelt, und danach nachgelesen
# (rn_mqtt_leeren() in rn_lib.php). Bis 2.1.10 blieben die Zustaende nach
# der Deinstallation im Broker, und Loxone las sie nach jedem Neustart von
# Broker oder Gateway wieder ein (in WSL gemessen, Pruefung-Renault-NG-2.1.11,
# Fall U1). Als loxberry, nicht als root; stdin geschlossen, damit su nie
# auf eine Eingabe wartet.
HTMLAUTH="$BASE/webfrontend/htmlauth/plugins/$PDIR"
if command -v php >/dev/null 2>&1 && [ -f "$HTMLAUTH/abruf.php" ]; then
    if [ "$(id -u)" = "0" ] && id loxberry >/dev/null 2>&1; then
        su -s /bin/bash loxberry -c "cd $(printf '%q' "$HTMLAUTH") && $(printf '%q ' env "LBHOMEDIR=$BASE" "LBPPLUGINDIR=$PDIR" timeout -k 5 60 php abruf.php --mqtt-leeren)" < /dev/null 2>&1
        mrc=$?
    else
        ( cd "$HTMLAUTH" && env "LBHOMEDIR=$BASE" "LBPPLUGINDIR=$PDIR" timeout -k 5 60 php abruf.php --mqtt-leeren ) < /dev/null 2>&1
        mrc=$?
    fi
    # 2.1.23 (Fremdpruefung B3): 0, 1 und 2 melden sich selbst (rn_mqtt_leeren()). Alles andere - 124/137 die
    # Zeitschranke, 255 ein Absturz - hat keine Zeile geschrieben; bis 2.1.22 blieb das still, und das Skript
    # endete mit 0.
    case "$mrc" in
        0|2) ;;
        1) rc=1 ;;
        *) echo "<WARNING> MQTT: das Leeren endete mit Rueckgabe $mrc (124/137 = Zeitschranke) - zurueckbehaltene Themen unter Renault/ koennen stehen geblieben sein."
           rc=1 ;;
    esac
else
    echo "<INFO> PHP oder abruf.php fehlt - zurueckbehaltene MQTT-Themen unter Renault/ wurden nicht geleert."
fi

# ---- 1. Zweitschrift der Konfiguration ----------------------------
# Sie liegt NEBEN dem Konfigordner und ueberlebt dessen Loeschung.
# Vor dem Entfernen wird sie ueberschrieben: eine geloeschte Datei mit
# einem Kennwort darin ist auf einer SD-Karte noch eine Weile lesbar.
SICH="$BASE/config/plugins/$PDIR.backup.config.php"
# V5 (T3-2/F5): ist die Zweitschrift ein VERWEIS, wird nur der Verweis entfernt -
# dd folgte ihm bis 2.1.19 und ueberschrieb das Ziel mit 8192 Nullbytes (in WSL
# gemessen, Pruefbericht T3-2). uninstall laeuft als root.
if [ -L "$SICH" ]; then
    rm -f "$SICH"
    echo "<WARNING> $SICH war ein Verweis - nur der Verweis wurde entfernt."
elif [ -f "$SICH" ]; then
    dd if=/dev/zero of="$SICH" bs=1024 count=8 conv=notrunc >/dev/null 2>&1
    if rm -f "$SICH"; then
        echo "<OK> Zweitschrift der Konfiguration entfernt (enthielt die Zugangsdaten)."
    else
        echo "<ERROR> Zweitschrift $SICH liess sich nicht entfernen - bitte von Hand."
        rc=1
    fi
else
    echo "<INFO> Keine Zweitschrift der Konfiguration vorhanden."
fi
# Seit 2.1.13 dazu: die bei einer Neuinstallation beiseitegelegte Zweitschrift
# (<ordner>.backup.config.php.alt, postinstall.sh, Entscheidung 1) und
# Konfigurationen, die preupgrade.sh bzw. postupgrade.sh als unbrauchbar neben
# den Ordner gelegt haben (<ordner>.config.php.kaputt.<zeit>, Befund I4) -
# alle mit Zugangsdaten im Klartext, alle ebenso ueberschrieben und entfernt.
for S in "$SICH.alt" "$BASE/config/plugins/$PDIR".config.php.kaputt.*; do
    if [ -L "$S" ]; then rm -f "$S"; echo "<WARNING> $S war ein Verweis - nur der Verweis wurde entfernt."; continue; fi
    [ -f "$S" ] && [ ! -L "$S" ] || continue
    dd if=/dev/zero of="$S" bs=1024 count=8 conv=notrunc >/dev/null 2>&1
    if rm -f "$S"; then
        echo "<OK> Beiseitegelegte Konfiguration entfernt ($S)."
    else
        echo "<ERROR> $S liess sich nicht entfernen - bitte von Hand."
        rc=1
    fi
done

# ---- 2. Rettungsordner der Ladehistorie ---------------------------
# Er entsteht in preupgrade.sh neben data/plugins/<ordner>/ und wird vom
# Installer nicht mit abgeraeumt.
# Dazu seine Baustellen aus preupgrade.sh (.neu, .alt), falls ein Update
# abgebrochen ist.
RETTUNG="$BASE/data/plugins/$PDIR.rettung"
for R in "$RETTUNG" "$RETTUNG.neu" "$RETTUNG.alt"; do
    [ -d "$R" ] || continue
    if rm -rf "$R"; then
        echo "<OK> Rettungsordner der Ladehistorie entfernt ($R)."
    else
        echo "<ERROR> Rettungsordner $R liess sich nicht entfernen."
        rc=1
    fi
done

# ---- 2b. Upgrade-Marke ---------------------------------------------
# data/plugins/<ordner>.upgrade_laeuft (seit 2.1.13, Entscheidung 1). Sie
# bleibt nur liegen, wenn ein Update zwischen preupgrade.sh und postupgrade.sh
# abbrach; ohne Abraeumen hielte eine spaetere Neuinstallation sich fuer ein
# Update und spielte Liegengebliebenes ein.
MARKE="$BASE/data/plugins/$PDIR.upgrade_laeuft"
if [ -f "$MARKE" ]; then
    if rm -f "$MARKE"; then
        echo "<OK> Upgrade-Marke eines abgebrochenen Updates entfernt ($MARKE)."
    else
        echo "<ERROR> Upgrade-Marke $MARKE liess sich nicht entfernen."
        rc=1
    fi
fi

# ---- 3. Nachzaehlen -----------------------------------------------
# Gemeldet wird, was gemessen ist - nicht, was beabsichtigt war.
REST=0
[ -f "$SICH" ] && REST=$((REST + 1))
[ -f "$SICH.alt" ] && REST=$((REST + 1))
for S in "$BASE/config/plugins/$PDIR".config.php.kaputt.*; do
    [ -f "$S" ] && REST=$((REST + 1))
done
[ -f "$MARKE" ] && REST=$((REST + 1))
for R in "$RETTUNG" "$RETTUNG.neu" "$RETTUNG.alt"; do
    [ -d "$R" ] && REST=$((REST + 1))
done
if [ "$REST" -eq 0 ]; then
    echo "<OK> Ausserhalb der Plugin-Ordner ist nichts von diesem Plugin uebrig."
else
    echo "<WARNING> $REST Rest(e) ausserhalb der Plugin-Ordner - siehe oben."
    rc=1
fi

echo "<INFO> Plugin-Ordner, Konfiguration und Zugangsdaten entfernt LoxBerry selbst."
echo "<INFO> Mit dem Konfigurationsordner geht auch mqtt_subscriptions.cfg - das"
echo "<INFO> MQTT-Gateway abonniert Renault/# danach nicht mehr (seit 2.1.9)."
echo "<INFO> Der einzige Dienst ist die Befehlsbruecke (oben angehalten); sonst arbeitet"
echo "<INFO> das Plugin ueber cron.01min, cron.03min und cron.10min, und diese Eintraege"
echo "<INFO> entfernt LoxBerry ebenfalls."
echo ""
echo "<INFO> Die zurueckbehaltenen MQTT-Themen der eingerichteten Fahrzeuge: das Ergebnis"
echo "<INFO> steht oben in den Zeilen MQTT."
echo "<INFO> Themen eines Fahrzeugs, das schon vorher aus den Einstellungen entfernt"
echo "<INFO> oder umbenannt wurde, kennt die Deinstallation nicht mehr. Seit 2.1.13 raeumt"
echo "<INFO> das Speichern der Einstellungen sie beim Umbenennen oder Entfernen ab; aeltere"
echo "<INFO> Reste lassen sich unter LoxBerry -> System -> MQTT Gateway loeschen."

exit $rc
