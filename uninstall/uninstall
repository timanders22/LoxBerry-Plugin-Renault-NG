#!/bin/bash
# Renault - uninstall
# command <TEMPFOLDER> <NAME> <FOLDER> <VERSION> <BASEFOLDER>
#
# Wird von LoxBerry als root ausgefuehrt. Rueckgabewert 0 = in Ordnung,
# 1 = Warnung (die Deinstallation laeuft trotzdem weiter).
#
# ===================================================================
# ZUR VORGESCHICHTE DIESER DATEI - bitte nicht wieder aufheben
# ===================================================================
#
# Bis 1.5 stand hier die unveraenderte LoxBerry-Beispieldatei: zwoelf
# Variablenzuweisungen, elf echo-Zeilen mit Pfaden und "exit 0". Sie hat
# nichts aufgeraeumt - sie hat nur ausgesehen, als taete sie es.
#
# Bis 2.1.5 stand hier dann etwas Falsches: der Text behauptete, die
# dauerhafte Konfigurationssicherung liege IM Konfigordner und werde mit
# ihm zusammen entfernt. (Der alte Wortlaut steht hier absichtlich nicht -
# sonst faende ihn jede Suche, die pruefen soll, ob er fort ist.)
# Er beschrieb den Stand bis 2.0.6. Seit 2.1.0 liegt die Zweitschrift
# NEBEN dem Ordner (config/plugins/<ordner>.backup.config.php) - genau
# deshalb ueberlebt sie das Loeschen, und genau deshalb blieb nach dem
# Entfernen des Plugins das My-Renault-Kennwort im Klartext auf der Anlage
# stehen. Eine spaetere Neuinstallation holte es ueber rn_umzug() samt
# Aktionstoken von selbst zurueck: was als Selbstheilung gedacht ist, war
# beim Entfernen das Gegenteil.
#
# Seit 2.1.6 raeumt diese Datei deshalb selbst auf. Seit 2.1.11 leert sie
# auch die zurueckbehaltenen MQTT-Themen der eingerichteten Fahrzeuge und
# liest beim Broker nach (abruf.php --mqtt-leeren); bis 2.1.10 sagte sie
# nur, dass der Broker bleibt.

PDIR="$3"
[ -n "$PDIR" ] || PDIR="renault_ng"
BASE="$5"
if [ -z "$BASE" ] || [ ! -d "$BASE" ]; then
    BASE="$LBHOMEDIR"
fi
# Fail closed: ohne Wurzel wird nichts geloescht, sondern gesagt, was
# liegenbleibt. Ein rm mit leerem Praefix ist schlimmer als ein Rest.
#
# Eine Wurzel ist nur, was config/plugins UND config/system/general.json
# traegt - ein LoxBerry hat sie immer, ein Rest eines Pruefstands nie
# (Regeln/06, "Eine Wurzelsuche ... trifft auf einem Pruefrechner das
# Laufwerk selbst"). Bis 2.1.10 genuegte config/plugins, und in einem
# fremden Baum wurde dessen Zweitschrift geloescht (in WSL gemessen,
# Pruefung-Renault-NG-2.1.11, Fall U4).
if [ -z "$BASE" ] || [ ! -d "$BASE/config/plugins" ] \
   || [ ! -f "$BASE/config/system/general.json" ]; then
    echo "<WARNING> Der LoxBerry-Ordner liess sich nicht bestimmen."
    echo "<WARNING> Die Zweitschrift der Konfiguration wurde NICHT entfernt."
    echo "<INFO> Sie enthaelt Benutzername und Kennwort des My-Renault-Kontos"
    echo "<INFO> im Klartext und liegt unter"
    echo "<INFO>     <loxberry>/config/plugins/$PDIR.backup.config.php"
    echo "<INFO> Bitte von Hand loeschen."
    exit 1
fi

rc=0

# ---- 0. Zurueckbehaltene MQTT-Themen -----------------------------
# VOR dem Loeschen der Zweitschrift: aus Konfiguration bzw. Zweitschrift
# kommen die Fahrzeugnamen, und sie sind Teil der Themen. Der Weg ist der der
# Linie (direkt am Broker, mit den Zugangsdaten des Gateways); geloescht wird
# nur, was der Broker noch zurueckbehaelt, und danach nachgelesen
# (rn_mqtt_leeren() in rn_lib.php). Bis 2.1.10 blieben die Zustaende nach
# der Deinstallation im Broker, und Loxone las sie nach jedem Neustart von
# Broker oder Gateway wieder ein (in WSL gemessen, Pruefung-Renault-NG-2.1.11,
# Fall U1). Als loxberry, nicht als root; stdin geschlossen, damit su nie
# auf eine Eingabe wartet.
HTMLAUTH="$BASE/webfrontend/htmlauth/plugins/$PDIR"
if command -v php >/dev/null 2>&1 && [ -f "$HTMLAUTH/abruf.php" ]; then
    if [ "$(id -u)" = "0" ] && id loxberry >/dev/null 2>&1; then
        su -s /bin/bash loxberry -c "cd $(printf '%q' "$HTMLAUTH") && $(printf '%q ' env "LBHOMEDIR=$BASE" "LBPPLUGINDIR=$PDIR" timeout 60 php abruf.php --mqtt-leeren)" < /dev/null 2>&1
        mrc=$?
    else
        ( cd "$HTMLAUTH" && env "LBHOMEDIR=$BASE" "LBPPLUGINDIR=$PDIR" timeout 60 php abruf.php --mqtt-leeren ) < /dev/null 2>&1
        mrc=$?
    fi
    [ "$mrc" = 1 ] && rc=1
else
    echo "<INFO> PHP oder abruf.php fehlt - zurueckbehaltene MQTT-Themen unter Renault/ wurden nicht geleert."
fi

# ---- 1. Zweitschrift der Konfiguration ----------------------------
# Sie liegt NEBEN dem Konfigordner und ueberlebt dessen Loeschung.
# Vor dem Entfernen wird sie ueberschrieben: eine geloeschte Datei mit
# einem Kennwort darin ist auf einer SD-Karte noch eine Weile lesbar.
SICH="$BASE/config/plugins/$PDIR.backup.config.php"
if [ -f "$SICH" ]; then
    dd if=/dev/zero of="$SICH" bs=1024 count=8 conv=notrunc >/dev/null 2>&1
    if rm -f "$SICH"; then
        echo "<OK> Zweitschrift der Konfiguration entfernt (enthielt die Zugangsdaten)."
    else
        echo "<ERROR> Zweitschrift $SICH liess sich nicht entfernen - bitte von Hand."
        rc=1
    fi
else
    echo "<INFO> Keine Zweitschrift der Konfiguration vorhanden."
fi

# ---- 2. Rettungsordner der Ladehistorie ---------------------------
# Er entsteht in preupgrade.sh neben data/plugins/<ordner>/ und wird vom
# Installer nicht mit abgeraeumt.
# Dazu seine Baustellen aus preupgrade.sh (.neu, .alt), falls ein Update
# abgebrochen ist.
RETTUNG="$BASE/data/plugins/$PDIR.rettung"
for R in "$RETTUNG" "$RETTUNG.neu" "$RETTUNG.alt"; do
    [ -d "$R" ] || continue
    if rm -rf "$R"; then
        echo "<OK> Rettungsordner der Ladehistorie entfernt ($R)."
    else
        echo "<ERROR> Rettungsordner $R liess sich nicht entfernen."
        rc=1
    fi
done

# ---- 3. Nachzaehlen -----------------------------------------------
# Gemeldet wird, was gemessen ist - nicht, was beabsichtigt war.
REST=0
[ -f "$SICH" ] && REST=$((REST + 1))
for R in "$RETTUNG" "$RETTUNG.neu" "$RETTUNG.alt"; do
    [ -d "$R" ] && REST=$((REST + 1))
done
if [ "$REST" -eq 0 ]; then
    echo "<OK> Ausserhalb der Plugin-Ordner ist nichts von diesem Plugin uebrig."
else
    echo "<WARNING> $REST Rest(e) ausserhalb der Plugin-Ordner - siehe oben."
    rc=1
fi

echo "<INFO> Plugin-Ordner, Konfiguration und Zugangsdaten entfernt LoxBerry selbst."
echo "<INFO> Mit dem Konfigurationsordner geht auch mqtt_subscriptions.cfg - das"
echo "<INFO> MQTT-Gateway abonniert Renault/# danach nicht mehr (seit 2.1.9)."
echo "<INFO> Einen Dienst hat das Plugin nicht; es arbeitet ueber cron.03min und"
echo "<INFO> cron.10min, und diese Eintraege entfernt LoxBerry ebenfalls."
echo ""
echo "<INFO> Die zurueckbehaltenen MQTT-Themen der eingerichteten Fahrzeuge sind oben"
echo "<INFO> geleert und beim Broker nachgelesen worden (Ergebnis in den Zeilen MQTT)."
echo "<INFO> Themen eines Fahrzeugs, das schon vorher aus den Einstellungen entfernt"
echo "<INFO> wurde, kennt das Plugin nicht mehr; sie lassen sich unter"
echo "<INFO> LoxBerry -> System -> MQTT Gateway loeschen."

exit $rc
