#!/bin/bash
# Renault - Ladevorgaenge des letzten Monats abholen und per MQTT melden.
# Aufbau wie cron.03min; die Begruendungen fuer Fehlermeldung, Zeilenenden
# und gemeinsame Sperre stehen dort.
VERZ="REPLACELBPHTMLAUTHDIR"
PROT="REPLACELBPLOGDIR/renault.log"

if [ ! -d "$VERZ" ]; then
    mkdir -p "$(dirname "$PROT")" 2>/dev/null
    echo "$(date '+%d.%m.%Y %H:%M:%S') [ERROR] Cron: Plugin-Verzeichnis nicht gefunden ($VERZ) - Plugin neu installieren." >> "$PROT"
    exit 1
fi

# Dieselbe Sperrdatei wie cron.03min - der Name kommt aus dem Ordnernamen,
# damit eine Zweitinstallation ihre eigene bekommt. Begruendung dort.
SPERRE="/tmp/$(basename "$VERZ").lock"
if ! exec 9>"$SPERRE"; then
    echo "$(date '+%d.%m.%Y %H:%M:%S') [ERROR] Cron: Sperrdatei $SPERRE nicht zu oeffnen - die Ladehistorie wird nicht geholt." >> "$PROT"
    exit 1
fi
flock -n 9 || exit 0

cd "$VERZ" || exit 1
php history.php
