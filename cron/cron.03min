#!/bin/bash
# Renault - Datenabruf alle drei Minuten.
#
# REPLACELBPHTMLAUTHDIR und REPLACELBPLOGDIR ersetzt der LoxBerry-Installer.
#
# ZEILENENDEN: DIESE DATEI IST LF, NICHT CRLF.
# Bis 2.0.6 war sie vollstaendig CRLF. Der Kernel sucht dann einen
# Interpreter namens "/bin/bash\r", findet ihn nicht und bricht mit
# Rueckgabewert 126 und "bad interpreter" ab - der Abruf lief nie. Und es
# genuegt NICHT, nur die Shebang-Zeile zu richten: mit CRLF im Rest wird aus
# VERZ der Wert "…\r", die Verzeichnispruefung unten schlaegt fehl, und das
# Skript schreibt "Plugin-Verzeichnis nicht gefunden" ins Protokoll.
# Wer diese Datei bearbeitet, prueft die Zeilenenden hinterher nach.
#
# WARUM HIER EINE FEHLERMELDUNG STEHT
# Bis 1.4 lautete die Zeile nur
#     cd REPLACELBPHTMLAUTHDIR && php abruf.php cron
# Das && faengt den Fehler zwar ab - aber lautlos. Bleibt der Platzhalter
# einmal unersetzt oder fehlt der Ordner, laeuft der Cron monatelang ins
# Leere, ohne dass jemand erfaehrt warum.
#
# Die Meldung geht NICHT nach /tmp: das ist auf dem LoxBerry eine Ramdisk,
# der Hinweis waere beim naechsten Neustart fort - und gerade dann sucht
# man ihn. Sie geht ins Protokoll des Plugins, das die Oberflaeche im
# Reiter "Logdateien" anzeigt.
VERZ="REPLACELBPHTMLAUTHDIR"
PROT="REPLACELBPLOGDIR/renault.log"

if [ ! -d "$VERZ" ]; then
    mkdir -p "$(dirname "$PROT")" 2>/dev/null
    echo "$(date '+%d.%m.%Y %H:%M:%S') [ERROR] Cron: Plugin-Verzeichnis nicht gefunden ($VERZ) - Plugin neu installieren." >> "$PROT"
    exit 1
fi

# ---- Sperre gegen Parallellaeufe -----------------------------------------
# EINE Sperre fuer BEIDE Cron-Skripte. Bis 2.0.6 hatte jedes seine eigene
# (/tmp/renault_abruf.lock gegen /tmp/renault_history.lock) - sie sperrten
# sich also gerade nicht gegeneinander, obwohl beide dieselben Dateien unter
# data/plugins/<ordner>/ lesen und schreiben. Bei einem Zusammentreffen
# ueberschrieb der langsamere den frischen Abruf des schnelleren mit seinem
# Stand von vor bis zu 80 Sekunden.
#
# Die Renault-Schnittstelle ist traege; die curl-Aufrufe tragen zwar
# Zeitschranken (10 s verbinden, 30 s gesamt), aber ein Lauf kann damit immer
# noch laenger dauern als der Cron-Takt.
# Der Name der Sperrdatei kommt aus dem ORDNERNAMEN, nicht fest aus dem
# Text. Bei einer Zweitinstallation haengt LoxBerry einen Zaehler an
# (renault_ng_01); mit einem festen Namen sperrten sich die beiden
# Installationen gegenseitig aus, und je Minute liefe nur eine von beiden.
SPERRE="/tmp/$(basename "$VERZ").lock"
#
# flock ist nicht blockierend: wer nicht drankommt, geht kommentarlos wieder -
# das ist der Normalfall und keine Meldung wert. Laesst sich die Sperrdatei
# gar nicht erst oeffnen (fremder Eigentuemer, volle Ramdisk), ist das etwas
# anderes: dann laeuft der Abruf nie wieder an, und bis 2.1.5 geschah das
# lautlos - in genau der Datei, die Lautlosigkeit zwanzig Zeilen weiter oben
# anprangert.
if ! exec 9>"$SPERRE"; then
    echo "$(date '+%d.%m.%Y %H:%M:%S') [ERROR] Cron: Sperrdatei $SPERRE nicht zu oeffnen - der Abruf laeuft nicht. Rechte und freien Platz auf der Ramdisk pruefen." >> "$PROT"
    exit 1
fi
flock -n 9 || exit 0

cd "$VERZ" || exit 1
php abruf.php cron
